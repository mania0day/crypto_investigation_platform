# CipherChain provider credentials — copy to .env and fill in.
# Every key is optional; the Provider SDK degrades gracefully to whatever is configured.
# Roles and free-tier notes: docs/research/PROVIDER_INVENTORY.md

# Class A: indexed history (address → transaction lists)
ETHERSCAN_API_KEY=

# Class B: raw JSON-RPC pool
DRPC_API_KEY=
ANKR_API_KEY=
INFURA_API_KEY=
ALCHEMY_API_KEY=
QUICKNODE_API_KEY=
QUICKNODE_ENDPOINT_URL=
CHAINSTACK_PLATFORM_API_KEY=
CHAINSTACK_ENDPOINT_URL=
GETBLOCK_ACCESS_TOKEN=

# Optional enrichment / tooling
TENDERLY_ACCESS_TOKEN=
SCALAR_API_TOKEN=

# ─── API-key auth (cipherchain.api.auth) ───
# Defaults to ENABLED; leave the line below commented out for any real deployment.
# Uncomment it ONLY for a local run — every guarded route then answers without a
# key, and the API serves case material and starts expensive traces.
# Mint keys with: python scripts/manage_api_keys.py mint --scopes read,investigate
#
# Note: unlike the credentials above, this is a bool — a bare `AUTH_ENABLED=`
# with no value fails startup with a validation error. Set true/false, or omit.
# AUTH_ENABLED=false
